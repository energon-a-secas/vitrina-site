# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store

# ── Playwright MCP (Claude Code browser automation: screenshots, logs) ───────
.playwright-mcp/

# ── Playwright test artifacts ─────────────────────────────────────────────────
test-results/
playwright-report/
blob-report/

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*

# ── Secrets, never commit ─────────────────────────────────────────────────────
.env
.env.*
# …but the credentials TEMPLATE is repo content: a fresh clone needs it
!.env.example

# ── Ephemeral skill working state (see neorgon-forge/docs/authoring.md) ───────
# Session briefs and maps. Useful while the work happens, not repo content, and
# on a site repo this directory is public.
.forge/

# ── Python bytecode ───────────────────────────────────────────────────────────
# smoke check 6 creates __pycache__ at repo root while exercising the tooling.
__pycache__/
*.py[cod]

# ── Logs ──────────────────────────────────────────────────────────────────────
# A site that deliberately ARCHIVES a log (rewind-site keeps the server.log of
# each snapshot) negates this in its own .gitignore. See REPO-ORGANIZATION.md.
*.log

# ── Archived skills (scripts/prune-skills.sh) ─────────────────────────────────
skills-archived/

# Scraper working files (projects/vitrina-site)
# The HTML cache is a local mirror of tercerafundacion.net pages: it exists so a
# re-run costs no requests, and it is not ours to republish.
data/.cache/
# Optional offline image copy. The published page hotlinks the source instead,
# so these are a fallback for local work, never something the repo ships.
data/images/

# Convex codegen output, rebuilt by every convex dev and deploy run from convex/.
convex/_generated/
